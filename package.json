{
  "name": "thinfilm-optics",
  "version": "1.0.0",
  "description": "多层薄膜反射透射谱与偏振分析后端（TypeScript + Node.js + SQLite，纯离线）",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "bin": { "thinfilm": "dist/cli.js" },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "demo": "node dist/demo.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
